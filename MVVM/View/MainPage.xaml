<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MVVM.ViewModel"
             x:Class="MVVM.MainPage"
             Title="Kalkulator Przesyłek">

    <ContentPage.BindingContext>
        <vm:PrzesylkaViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="15">

        <Label Text="Nadaj paczkę kurierską"
               FontSize="24"
               FontAttributes="Bold">
        </Label>

        <Label Text="Adresat przesylki: "></Label>
        <Entry Text="{Binding WpisanyAdresat}"></Entry>
        
        <Label Text="Waga paczki: "></Label>
        <Entry Text="{Binding WpisanaWaga}" Keyboard="Numeric"></Entry>

        <HorizontalStackLayout Spacing="10">
            
            <CheckBox IsChecked="{Binding WybranyEkspres}"></CheckBox>
            <Label Text="Przesylka ekspresowa (+20zl)" 
                   VerticalOptions="Center">
            </Label>
            
        </HorizontalStackLayout>

        <Button Text="Oblicz cene" Command="{Binding ObliczCeneCommand}"></Button>

        <Label Text="{Binding KomunikatWyniku}"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="LightGreen">
        </Label>
        
    </VerticalStackLayout>
</ContentPage>
